{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kut-olokon",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/login", "/login/", "/setup", "/setup/"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dd28ea81205a466292875ccdb3c79575"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EMPLOYEE_FILES",
      "bucket_name": "kut-private-employee-files"
    }
  ]
}
